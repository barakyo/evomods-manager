<!--
    EvoMods brand theme, taken from the site's own tokens.

    The site is defined in oklch (assets/css/app.css in the evomods repo) and XAML has no oklch, so
    every value here is the converted sRGB of the token named beside it. Converting rather than
    eyeballing matters: oklch is perceptually uniform and sRGB is not, so picking "a similar red" by
    hand drifts, and drifts differently at different lightnesses.

        color-base-100      oklch(17% 0.013 264)   #0D0F15   page background
        color-base-200      oklch(21% 0.015 264)   #15181F   cards, surfaces
        color-base-300      oklch(26% 0.017 264)   #20242C   borders
        color-base-content  oklch(95% 0.008 250)   #EBEFF4   text
        color-primary       oklch(60% 0.236 26)    #EC1627   red
        color-secondary     oklch(80% 0.13 205)    #2AD5E5   blue
        color-accent        oklch(86% 0.17 95)     #F4CE23   yellow
        color-neutral       oklch(28% 0.012 264)   #26292F

    Dark only, like the site. The app sets RequestedTheme="Dark", so the light dictionary is never
    reached. It is defined anyway rather than left missing, because a control that resolves a missing
    key falls back to the stock theme and shows up as one stray light-mode panel.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">

            <!-- The brand palette, for pages to reach directly. -->
            <SolidColorBrush x:Key="BrandBackground" Color="#0D0F15" />
            <SolidColorBrush x:Key="BrandSurface" Color="#15181F" />
            <SolidColorBrush x:Key="BrandBorder" Color="#20242C" />
            <SolidColorBrush x:Key="BrandInk" Color="#EBEFF4" />
            <SolidColorBrush x:Key="BrandRed" Color="#EC1627" />
            <SolidColorBrush x:Key="BrandBlue" Color="#2AD5E5" />
            <SolidColorBrush x:Key="BrandYellow" Color="#F4CE23" />

            <!-- Surfaces. -->
            <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="#0D0F15" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#0D0F15" />
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#0D0F15" />
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#0D0F15" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#15181F" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#0D0F15" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#15181F" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#15181F" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#15181F" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#20242C" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#20242C" />
            <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#20242C" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#20242C" />
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#20242C" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#26292F" />
            <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#15181F" />

            <!-- Text. -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#EBEFF4" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#98A2B0" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6C7686" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#EBEFF4" />

            <!-- Red is the accent: buttons, sliders, progress, selection. -->
            <Color x:Key="SystemAccentColor">#EC1627</Color>
            <Color x:Key="SystemAccentColorLight1">#F03D4B</Color>
            <Color x:Key="SystemAccentColorLight2">#F4646F</Color>
            <Color x:Key="SystemAccentColorDark1">#C51120</Color>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#EC1627" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#D91324" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C51120" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#F4646F" />
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#EC1627" />

            <!--
                Text ON the red. The site's primary-content is #FFF6F6, and the red is dark enough to
                carry it: white on #EC1627 clears 4.5:1, so an accent button stays readable rather
                than relying on the reader not looking closely.
            -->
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFF6F6" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFF6F6" />

            <!-- Status. Blue and yellow do the informational and caution work. -->
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#53C75D" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#15211A" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#F4CE23" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#231F10" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#EC1627" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#241216" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#2AD5E5" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#0F1E24" />
            <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="#98A2B0" />
            <SolidColorBrush x:Key="SystemFillColorNeutralBackgroundBrush" Color="#15181F" />

            <!-- Selection in the nav pane. -->
            <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#EC1627" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#15181F" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#20242C" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#EBEFF4" />

        </ResourceDictionary>

        <!-- Never reached; present so nothing resolves to a stock light-mode fallback. -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BrandBackground" Color="#0D0F15" />
            <SolidColorBrush x:Key="BrandSurface" Color="#15181F" />
            <SolidColorBrush x:Key="BrandBorder" Color="#20242C" />
            <SolidColorBrush x:Key="BrandInk" Color="#EBEFF4" />
            <SolidColorBrush x:Key="BrandRed" Color="#EC1627" />
            <SolidColorBrush x:Key="BrandBlue" Color="#2AD5E5" />
            <SolidColorBrush x:Key="BrandYellow" Color="#F4CE23" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        Shipped with the app rather than assumed present: none of these are Windows fonts. The
        "#Family Name" suffix is required. Without it the file loads and silently falls back.
        Segoe UI Variable stays the body face on purpose. Inter is the site's, and Segoe is close
        enough that shipping a second neutral grotesque buys nothing, while keeping running text
        native to the OS.
    -->
    <FontFamily x:Key="BrandDisplayFont">ms-appx:///Assets/Fonts/SairaCondensed-Black.ttf#Saira Condensed Black</FontFamily>
    <FontFamily x:Key="BrandNumeralFont">ms-appx:///Assets/Fonts/Rajdhani-SemiBold.ttf#Rajdhani SemiBold</FontFamily>

</ResourceDictionary>
