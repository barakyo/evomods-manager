<Page
    x:Class="EvoMods.App.Pages.CameraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Chase camera" Style="{StaticResource TitleTextBlockStyle}"
                       FontFamily="{StaticResource BrandDisplayFont}" FontSize="34"
                       CharacterSpacing="20" />
            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Read at startup, so how the car drives and how the camera looks are fully separate: drive a clean lap on normal settings, exit, set a cinematic camera, relaunch and record the replay. An undriveable camera is an acceptable camera." />
        </StackPanel>

        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="False" />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
            <StackPanel Spacing="20">

                <!-- Framing: where the camera sits. A different file from everything below it. -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Chase camera framing"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Preset" MinWidth="210" VerticalAlignment="Center"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox x:Name="PresetBox" Width="300"
                                  SelectionChanged="OnPresetChanged" />
                    </StackPanel>

                    <TextBlock x:Name="PresetBlurb" TextWrapping="Wrap" MaxWidth="640"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <!-- Only ever shown when the file disagrees with itself, which explains Custom. -->
                    <TextBlock x:Name="DisagreeNote" TextWrapping="Wrap" MaxWidth="640"
                               Visibility="Collapsed"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <StackPanel x:Name="CustomRows" Spacing="12" Visibility="Collapsed" />

                    <TextBlock TextWrapping="Wrap" MaxWidth="640" Margin="0,4,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="Applied to every car in the file. Field of view is one value shared by all of them — the game has no per-car setting to narrow it to." />
                </StackPanel>

                <!-- Behaviour and driver view: the settings file the game reads at startup. -->
                <StackPanel x:Name="Rows" Spacing="20" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <Button x:Name="ApplyButton" Content="Apply" Click="OnApply"
                    Style="{StaticResource AccentButtonStyle}" />
            <Button x:Name="RestoreButton" Content="Restore game defaults" Click="OnRestore" />
            <Button x:Name="RevertButton" Content="Discard changes" Click="OnRevert" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>
