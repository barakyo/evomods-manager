<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EvoMods.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The same avatar the social accounts use, so the taskbar, Alt-Tab and the Start menu entry
         all carry the mark rather than the generic WinUI placeholder. -->
    <ApplicationIcon>Assets\evomods.ico</ApplicationIcon>

    <!-- Required even though nothing here is packaged as MSIX. It is what runs MakePri, and
         without the app's own resources.pri WinUI cannot load the compiled XAML: the app builds,
         installs and updates perfectly, then dies at InitializeComponent with a bare E_FAIL. -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <!-- Velopack owns the entry point: install/update/uninstall hooks run through this same exe
         and must complete before a window is ever created. See Program.cs. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- Unpackaged and fully self-contained. Both halves are needed and they cover different
         things: WindowsAppSDKSelfContained carries the native Windows App SDK, SelfContained
         carries the .NET runtime. WinUI 3 cannot produce a single-file exe — the native runtime
         files have to stay loose next to it — which is why the installer is the delivery
         mechanism rather than a convenience. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <AssemblyName>EvoMods</AssemblyName>

    <!-- Also passed on the command line by build\pack.ps1, which is what a release actually uses.
         Kept in step so a build run straight out of the IDE does not claim to be something else. -->
    <Version>0.3.0</Version>

    <AssemblyTitle>EvoMods Manager</AssemblyTitle>
    <Product>EvoMods Manager</Product>
    <Company>itsbarakyo</Company>
    <Description>Manages Assetto Corsa EVO mods: tracks, post-processing filters and camera settings.</Description>
  </PropertyGroup>

  <!-- The brand mark and the two shipped fonts. Reached at run time through ms-appx:///Assets/…,
       which resolves to the app folder, so they have to actually land there. -->
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <ProjectReference Include="..\EvoMods.Core\EvoMods.Core.csproj" />
  </ItemGroup>

</Project>
